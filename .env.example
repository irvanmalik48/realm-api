# Server & Networking Configuration
PORT=8080
GRPC_PORT=50051
ENVIRONMENT=development
ALLOWED_ORIGINS=https://irvanma.eu.org,http://localhost:3000

# PostgreSQL Credentials (used by Docker Compose & backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realm
DB_PORT=5432

# Database URL:
# - For Docker Compose: Constructed automatically as postgres://<user>:<pass>@realm-postgres:5432/<db>?sslmode=disable
# - For Local Development (running go run ./cmd/server on host):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realm?sslmode=disable

# Storage Configuration (Local Zstd Disk or S3-Compatible Storage like SeaweedFS/Garage/AWS S3)
STORAGE_BACKEND=local # 'local' or 's3'
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=50

# S3 Compatible Storage Configuration (SeaweedFS / Garage / Cloudflare R2 / AWS S3)
# When running with Docker Compose on the same server, API talks to SeaweedFS at http://realm-seaweedfs:8333
# For local host dev outside Docker: http://localhost:8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=realm-assets
S3_ACCESS_KEY_ID=realm
S3_SECRET_ACCESS_KEY=realmsecret
S3_USE_PATH_STYLE=true
# Optional: Set when SeaweedFS has a public domain/subdomain on the reverse proxy (e.g. https://s3.irvanma.eu.org).
# If left empty, files are served transparently via the API gateway (https://api.irvanma.eu.org/v1/storage/:id).
S3_PUBLIC_DOMAIN=

# LastFM API Credentials & Cache
LASTFM_API_KEY=
LASTFM_API_SECRET=
CACHE_REVALIDATE_SECONDS=900

# Contact Notifications & SMTP (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_RECEIVER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Authentication & Session Token (PASETO v2)
# 32-byte key for symmetric encryption (generate with `openssl rand -hex 32`)
PASETO_SYMMETRIC_KEY=
FRONTEND_URL=http://localhost:3000
# Initial superadmin email allowlist (comma-separated, automatically granted superadmin on startup)
SUPERADMIN_EMAILS=

# Google OIDC Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/v1/auth/github/callback

# Observability, Profiling & Structured Logging
# OTLP gRPC endpoint for OpenTelemetry traces (e.g. localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana Pyroscope continuous profiling server (e.g. http://localhost:4040)
PYROSCOPE_SERVER_ADDRESS=
LOG_LEVEL=info
LOG_FORMAT=json


