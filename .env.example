# Server Configuration
PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=https://irvanma.eu.org,http://localhost:3000

# PostgreSQL Credentials (used by Docker Compose & backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realm
DB_PORT=5432

# Database URL:
# - For Docker Compose: Constructed automatically as postgres://<user>:<pass>@realm-postgres:5432/<db>?sslmode=disable
# - For Local Development (running go run ./cmd/server on host):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/realm?sslmode=disable

# Storage Configuration (Zstd Compressed Disk Storage)
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=10

# LastFM API Credentials
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Contact Notifications (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Authentication & Session Token (PASETO v2)
# 32-byte key for symmetric encryption (generate with `openssl rand -hex 32`)
PASETO_SYMMETRIC_KEY=
FRONTEND_URL=http://localhost:3000

# Google OIDC Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/v1/auth/github/callback

